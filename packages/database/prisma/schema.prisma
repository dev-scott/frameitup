generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ARTIST
  ADMIN
  FINANCE
}

enum OrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FrameMaterial {
  WOOD
  METAL
  ACRYLIC
  COMPOSITE
}

enum GlasingType {
  STANDARD
  UV_PROTECTIVE
  ANTI_REFLECTIVE
  MUSEUM_GLASS
}

enum ArtworkEdition {
  OPEN
  LIMITED
  ONE_OF_ONE
}

enum RevenueSource {
  SAAS_FRAME
  MARKETPLACE
  SUBSCRIPTION
  CORPORATE
}

enum ExpenseCategory {
  RAW_MATERIALS_WOOD
  RAW_MATERIALS_GLASS
  PACKAGING
  SHIPPING_LOGISTICS
  MARKETING_ADS
  SOFTWARE_SERVERS
  PAYROLL_SALARIES
  WORKSHOP_RENT
  PAYMENT_FEES
  LEGAL_ACCOUNTING
  OTHER_OPEX
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  STRIPE
  PAYPAL
  DIRECT_DEBIT
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_60
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum JournalEntryType {
  DEBIT
  CREDIT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole  @default(CUSTOMER)
  orders      Order[]
  artist      ArtistProfile?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model Frame {
  id           String        @id @default(cuid())
  name         String
  material     FrameMaterial
  color        String
  widthMm      Float
  heightMm     Float
  depthMm      Float
  priceUsd     Decimal       @db.Decimal(10, 2)
  thumbnailUrl String
  available    Boolean       @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("frames")
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  items                 OrderItem[]
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingState         String
  shippingPostalCode    String
  shippingCountry       String
  whatsapp              String?
  totalUsd              Decimal     @db.Decimal(10, 2)
  stripePaymentIntentId String?     @unique
  trackingNumber        String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id])
  frameId      String
  frame        Frame       @relation(fields: [frameId], references: [id])
  imageUrl     String
  matColor     String?
  glasingType  GlasingType @default(STANDARD)
  widthPx      Int
  heightPx     Int
  cropData     Json?
  quantity     Int         @default(1)
  unitPriceUsd Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())

  @@map("order_items")
}

model ArtistProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  bio              String
  portfolioUrl     String?
  country          String
  stripeConnectId  String?        @unique
  royaltyPercent   Decimal        @default(70) @db.Decimal(5, 2)
  verified         Boolean        @default(false)
  artworks         Artwork[]
  payouts          ArtistPayout[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("artist_profiles")
}

model Artwork {
  id             String         @id @default(cuid())
  artistId       String
  artist         ArtistProfile  @relation(fields: [artistId], references: [id])
  title          String
  description    String
  imageUrl       String
  priceUsd       Decimal        @db.Decimal(10, 2)
  edition        ArtworkEdition @default(OPEN)
  tags           String[]
  availableCount Int            @default(-1) // -1 = unlimited
  soldCount      Int            @default(0)
  published      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("artworks")
}

model RevenueEntry {
  id         String        @id @default(cuid())
  source     RevenueSource
  amountUsd  Decimal       @db.Decimal(10, 2)
  cogsUsd    Decimal       @db.Decimal(10, 2)
  profitUsd  Decimal       @db.Decimal(10, 2)
  orderId    String?
  period     String        // YYYY-MM
  recordedAt DateTime      @default(now())

  @@index([period])
  @@index([source])
  @@map("revenue_entries")
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("subscriptions")
}

// ─── Modèles Finance & Comptabilité Entreprise ──────────────────────────────

model Supplier {
  id            String          @id @default(cuid())
  name          String
  category      ExpenseCategory
  contactEmail  String?
  contactPhone  String?
  taxId         String?         // N° TVA intracommunautaire / SIRET
  paymentTerms  PaymentTerms    @default(NET_30)
  currency      String          @default("USD")
  balanceDueUsd Decimal         @default(0) @db.Decimal(10, 2)
  expenses      Expense[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("suppliers")
}

model Expense {
  id             String          @id @default(cuid())
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  supplierName   String?
  category       ExpenseCategory
  description    String
  amountUsd      Decimal         @db.Decimal(10, 2) // Montant HT
  taxRatePercent Decimal         @default(20) @db.Decimal(5, 2) // TVA %
  taxAmountUsd   Decimal         @default(0) @db.Decimal(10, 2)
  totalWithTaxUsd Decimal        @db.Decimal(10, 2) // Montant TTC
  status         ExpenseStatus   @default(PAID)
  paymentMethod  PaymentMethod   @default(BANK_TRANSFER)
  date           DateTime        @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  period         String          // YYYY-MM
  isRecurring    Boolean         @default(false)
  receiptUrl     String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([period])
  @@index([category])
  @@index([status])
  @@map("expenses")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  orderId        String?
  clientName     String
  clientEmail    String
  clientAddress  String?
  clientTaxId    String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotalUsd    Decimal       @db.Decimal(10, 2) // Total HT
  taxRatePercent Decimal       @default(20) @db.Decimal(5, 2)
  taxAmountUsd   Decimal       @default(0) @db.Decimal(10, 2)
  totalUsd       Decimal       @db.Decimal(10, 2) // Total TTC
  status         InvoiceStatus @default(ISSUED)
  paidAt         DateTime?
  items          Json?         // Lignes de facture [{ description, qty, unitPrice, total }]
  pdfUrl         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("invoices")
}

model ArtistPayout {
  id               String        @id @default(cuid())
  artistId         String
  artist           ArtistProfile @relation(fields: [artistId], references: [id])
  amountUsd        Decimal       @db.Decimal(10, 2)
  period           String        // YYYY-MM
  status           PayoutStatus  @default(PENDING)
  stripeTransferId String?
  processedAt      DateTime?
  artworksCount    Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([period])
  @@index([status])
  @@map("artist_payouts")
}

model FinancialBudget {
  id              String   @id @default(cuid())
  period          String   // YYYY-MM
  category        String   // REVENUE_SAAS, COGS_MATERIALS, MARKETING, PAYROLL, RENT, SOFTWARE
  targetAmountUsd Decimal  @db.Decimal(10, 2)
  actualAmountUsd Decimal  @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([period, category])
  @@map("financial_budgets")
}

model JournalEntry {
  id          String           @id @default(cuid())
  entryNumber String           @unique
  date        DateTime         @default(now())
  accountCode String           // ex: "701" (Ventes), "601" (Achats matières), "512" (Banque), "44571" (TVA Collectée)
  accountName String
  type        JournalEntryType
  amountUsd   Decimal          @db.Decimal(10, 2)
  description String
  reference   String?          // ID commande ou facture
  createdAt   DateTime         @default(now())

  @@index([accountCode])
  @@map("journal_entries")
}
